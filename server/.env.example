# =============================================================================
# JustX Business Tools (JBT) — environment template
# Copy to: server/.env  (never commit real secrets)
# Setup: docs/SETUP.md  ·  Deploy: docs/DEPLOY.md
# =============================================================================

PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=justx_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=justx_systems

# Browser origin of the web UI (scheme + host only — NO /jbt path here)
# Local:  http://localhost:3000
# Prod:   https://justxsystems.com
CORS_ORIGIN=http://localhost:3000

# When the UI is served under a path (production JustX hosting):
# WEB_PUBLIC_ORIGIN=https://justxsystems.com
# WEB_BASE_PATH=/jbt
# NEXT_PUBLIC_BASE_PATH=/jbt   # set when building/running the web app

# Session / token encryption (REQUIRED in production — long random string)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
REQUIRE_AUTH=true

# Uploaded images (logos). local = disk under UPLOAD_DIR; s3/cloud = S3-compatible bucket
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# Platform Google OAuth (OPTIONAL — prefer Admin → Integrations)
# One client for Sign in with Google + Company Drive connect.
# Admin DB overrides these env vars when saved; env remains bootstrap fallback.
# Created once in Google Cloud (e.g. under justxsystems@gmail.com)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
#
# Local callbacks (API must be reachable at these exact URLs):
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/profile/drive/callback
# API_PUBLIC_URL=http://localhost:4000
#
# Production callbacks (example for justxsystems.com):
# GOOGLE_REDIRECT_URI=https://justxsystems.com/jbt/api/auth/google/callback
# GOOGLE_DRIVE_REDIRECT_URI=https://justxsystems.com/jbt/api/profile/drive/callback
# API_PUBLIC_URL=https://justxsystems.com/jbt
#
# Optional: encrypt Drive refresh tokens separately (defaults to JWT_SECRET)
# DRIVE_TOKEN_SECRET=
# ARTIFACT_RETRY_MS=60000

# -----------------------------------------------------------------------------
# Email Path A webhook (OPTIONAL — prefer Admin → Integrations)
# HTTPS inbound hook YOU create (n8n/Make/Zapier/Power Automate). Not SMTP.
# Admin DB overrides env when saved.
# -----------------------------------------------------------------------------
# EMAIL_WEBHOOK_URL=https://hook.example.com/jbt-email
# NOTIFY_EMAIL_WEBHOOK_URL=   # alias only if EMAIL_WEBHOOK_URL unset

# -----------------------------------------------------------------------------
# WhatsApp / SMS / Error webhook (OPTIONAL — prefer Admin → Integrations)
# Admin DB overrides env when saved.
# -----------------------------------------------------------------------------
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# SMS_PROVIDER=console
# ENABLE_PHONE_OTP=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# SMS_API_URL=
# ERROR_WEBHOOK_URL=

# Optional platform-wide Drive service account (NOT needed for multi-tenant)
# Prefer: Profile → Connect company Google Drive
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=

# Subscription / payments (dev defaults — production must disable auto-complete)
PAYMENT_PROVIDER=mock
PAYMENT_AUTO_COMPLETE=true
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
SUBSCRIPTION_PRO_PRICE_INR=499
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Observability (see docs/OBSERVABILITY.md)
# LOG_FORMAT=json
# GRAFANA_PUBLIC_URL=https://justxsystems.com/grafana
# SENTRY_DSN=   # stays in .env (infra); error webhook prefer Admin → Integrations
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Web (Capacitor / static hosting) — API origin when Next /api rewrite is unavailable
# NEXT_PUBLIC_API_URL=https://justxsystems.com/jbt

# Capacitor dev — load WebView from dev server instead of web/out
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
