PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=justx_user
DB_PASSWORD=devpassword
DB_NAME=justx_systems
CORS_ORIGIN=http://localhost:3000

# Uploaded images (logos)
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
# UPLOAD_PUBLIC_BASE_URL=http://localhost:4000
# UPLOAD_DRIVER=s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_ENDPOINT=

# Subscription / payments (dev defaults)
PAYMENT_PROVIDER=mock
PAYMENT_AUTO_COMPLETE=true
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
SUBSCRIPTION_PRO_PRICE_INR=499

# Phone OTP / SMS
SMS_PROVIDER=console
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_PROVIDER=http
# SMS_API_URL=https://your-sms-gateway.example/send
# SMS_API_KEY=
# SMS_PHONE_FIELD=phone
# SMS_MESSAGE_FIELD=message
# OTP_TTL_MS=300000
# OTP_MAX_ATTEMPTS=5

# Google OAuth (optional — only for “Sign in with Google”, not for Drive Send Via)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# API_PUBLIC_URL=http://localhost:4000
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
#
# Optional: real email delivery for Quotation → Send Via → Email
# Without this, the app opens the user's mail client (mailto) + downloads the PDF to attach.
# EMAIL_WEBHOOK_URL=https://your-automation.example/email
# NOTIFY_EMAIL_WEBHOOK_URL=

# Optional: automatic WhatsApp PDF delivery (browser links cannot attach files)
# Option A — Meta WhatsApp Cloud API (sends document + caption to each number):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# Option B — webhook (n8n / Make / your worker receives phones + message + pdfBase64):
# WHATSAPP_WEBHOOK_URL=https://your-automation.example/whatsapp
#
# Note: Cloud API free-form documents only work inside the 24-hour customer-care window
# (or via an approved message template). Cold outreach may need a template on Meta.

# Razorpay (production payments)
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# PLATFORM_ADMIN_EMAIL=admin@justx.local

# Analytics rollup scheduler (hours between runs; 0 = disabled)
ANALYTICS_ROLLUP_INTERVAL_HOURS=24
