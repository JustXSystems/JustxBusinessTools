# Optional shared env overrides for operators (not committed with secrets).
# Copy to /opt/justx/config/deploy.env on the server and `source` before deploy.
#
# export DEPLOY_MODE=interactive
# export SSL_EMAIL=justxsystems@gmail.com
# export PROCESS_MANAGER=pm2
# export DEPLOY_WEBHOOK_URL=
# export AUTO_ROLLBACK_ON_FAIL=1
# export INSTALL_MYSQL_SERVER=1
# export CONFIGURE_FIREWALL=1
#
# JBT production: https://justxsystems.com/jbt/  web:3002 api:4002 (3001 = Zigma)
