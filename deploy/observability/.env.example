GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-now
GF_SERVER_ROOT_URL=https://justxsystems.com/grafana/
GF_SERVER_DOMAIN=justxsystems.com

# Optional MySQL metrics (docs/OBSERVABILITY.md §4.7)
# Uncomment and set, then:
#   docker compose --profile mysql-metrics up -d --force-recreate mysqld-exporter
# Do NOT use MYSQL_EXPORTER_DSN (ignored by exporter v0.15+).
# MYSQL_EXPORTER_USER=jbt_exporter
# MYSQL_EXPORTER_PASSWORD=USE_A_LONG_RANDOM_PASSWORD
# MYSQL_EXPORTER_HOST=host.docker.internal:3306
