GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-now
GF_SERVER_ROOT_URL=https://justxsystems.com/grafana/
GF_SERVER_DOMAIN=justxsystems.com

# Optional MySQL metrics — ONLY needed for: docker compose --profile mysql-metrics up -d
# 1) Create MySQL user (docs §4.7)
# 2) Uncomment and set (no quotes, no spaces around =, trailing / required):
# MYSQL_EXPORTER_DSN=jbt_exporter:YOUR_SECRET@(host.docker.internal:3306)/
#
# Wrong / empty DSN → exporter crash-loop: "no user specified" / "no configuration found"
# After editing: docker compose --profile mysql-metrics up -d --force-recreate mysqld-exporter
